NODE_ENV=development

API_PORT=4000
CORS_ORIGIN=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:4000

DATABASE_URL=postgresql://studio:studio@localhost:5432/studio?schema=public
REDIS_URL=redis://localhost:6379
EMBEDDED_PG_PORT=5433

JWT_ACCESS_SECRET=dev-access-secret-change-me
JWT_REFRESH_SECRET=dev-refresh-secret-change-me
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

STORAGE_DRIVER=s3
STORAGE_FS_ROOT=.data/storage
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=studio-assets
S3_FORCE_PATH_STYLE=true
S3_PUBLIC_BASE_URL=http://localhost:9000

GEMINI_API_KEY=
GOOGLE_CLOUD_PROJECT=
GOOGLE_APPLICATION_CREDENTIALS=
LLM_PROVIDER=auto
IMAGE_PROVIDER=auto
VIDEO_PROVIDER=auto
AUDIO_PROVIDER=auto
VIDEO_CONCURRENCY=1
AUDIO_CONCURRENCY=2
QC_CONCURRENCY=2
RENDER_CONCURRENCY=1
PAUSE_RETRY_MS=10000
FFMPEG_PATH=
FFPROBE_PATH=

# Providers: auto|mock|gemini|google-omni|google-cloud-tts
# auto → live when credentials exist, otherwise mock
# Production: set strong JWT_* secrets (startup refuses change-me when NODE_ENV=production)

LLM_MODEL_CHEAP=gemini-2.5-flash
LLM_MODEL_CREATIVE=gemini-2.5-pro
IMAGE_MODEL=gemini-2.5-flash-image
VIDEO_MODEL=gemini-omni-1.2-flash



SEED_ADMIN_EMAIL=admin@studio.local
SEED_ADMIN_PASSWORD=Admin123!
