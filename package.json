{
  "name": "ai-video-studio",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "dev": "pnpm -r --parallel --filter @studio/api --filter @studio/web --filter @studio/workers run dev",
    "dev:api": "pnpm --filter @studio/api dev",
    "dev:web": "pnpm --filter @studio/web dev",
    "dev:workers": "pnpm --filter @studio/workers dev",
    "build": "pnpm -r run build",
    "db:generate": "pnpm --filter @studio/db generate",
    "db:migrate": "pnpm --filter @studio/db migrate",
    "db:push": "pnpm --filter @studio/db push",
    "db:seed": "pnpm --filter @studio/db seed",
    "db:embedded": "node scripts/start-embedded-pg.mjs",
    "validate:phase1": "node scripts/validate-phase1.mjs",
    "validate:phase2": "node scripts/validate-phase2.mjs",
    "validate:phase3": "node scripts/validate-phase3.mjs",
    "validate:phase4": "node scripts/validate-phase4.mjs",
    "validate:phase5": "node scripts/validate-phase5.mjs",
    "validate:phase6": "node scripts/validate-phase6.mjs",
    "validate:phase7": "node scripts/validate-phase7.mjs",
    "validate:phase8": "node scripts/validate-phase8.mjs",
    "validate:phase9": "node scripts/validate-phase9.mjs",
    "validate:phase10": "node scripts/validate-phase10.mjs",
    "validate:e2e": "node scripts/validate-phase10.mjs",
    "lint": "pnpm -r run lint",
    "typecheck": "pnpm -r run typecheck"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "embedded-postgres": "18.6.0-beta.19"
  }
}
