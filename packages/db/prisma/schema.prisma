generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum GenerationMode {
  TOPIC_TO_VIDEO
  SCRIPT_TO_VIDEO
  VIDEO_REFERENCE
}

enum VisualStyle {
  CINEMATIC
  ANIMATION_2D
  ANIMATION_3D
  REALISTIC
  DOCUMENTARY
  EDUCATIONAL
  CARTOON
  ANIME
  EXPLAINER
  CUSTOM
}

enum Resolution {
  P720
  P1080
  P4K
}

enum AspectRatio {
  LANDSCAPE_16_9
  PORTRAIT_9_16
}

enum ProjectStatus {
  DRAFT
  PLANNING
  GENERATING
  PAUSED
  RENDERING
  COMPLETED
  FAILED
  CANCELLED
}

enum SegmentStatus {
  PENDING
  QUEUED
  GENERATING
  SUCCEEDED
  FAILED
  CANCELLED
}

enum JobStatus {
  PENDING
  QUEUED
  RUNNING
  SUCCEEDED
  FAILED
  CANCELLED
}

enum JobType {
  STORY_GENERATION
  SCRIPT_ANALYSIS
  CHARACTER_GENERATION
  ENVIRONMENT_GENERATION
  STORYBOARD_GENERATION
  VIDEO_GENERATION
  VIDEO_EXTENSION
  AUDIO_GENERATION
  QUALITY_CONTROL
  VIDEO_RENDERING
  EPISODE_CONTINUATION
}

enum AssetType {
  IMAGE
  VIDEO
  AUDIO
  SUBTITLE
  DOCUMENT
  OTHER
}

enum VideoStrategy {
  TEXT_TO_VIDEO
  IMAGE_TO_VIDEO
  REFERENCE_TO_VIDEO
  FIRST_LAST_FRAME
  EXTEND
  REUSE
  IMAGE_ANIMATION
}

enum AudioSource {
  NATIVE_VIDEO
  CLOUD_TTS
  GEMINI_TTS
  UPLOADED
  NONE
}

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  passwordHash String
  name         String
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  projects     Project[]
  refreshTokens RefreshToken[]
}

model RefreshToken {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

model Project {
  id                    String         @id @default(cuid())
  userId                String
  user                  User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  title                 String
  mode                  GenerationMode
  topic                 String?
  targetDurationSeconds Int
  storyLanguage         String         @default("en")
  dialogueLanguage      String         @default("en")
  narrationLanguage     String         @default("en")
  voiceLanguage         String         @default("en")
  subtitleLanguage      String         @default("en")
  visualStyle           VisualStyle    @default(CINEMATIC)
  customStyleNotes      String?
  resolution            Resolution     @default(P720)
  aspectRatio           AspectRatio    @default(LANDSCAPE_16_9)
  videoProvider         String         @default("google-omni")
  budgetLimitUsd        Decimal?       @db.Decimal(12, 4)
  estimatedCostUsd      Decimal?       @db.Decimal(12, 4)
  actualCostUsd         Decimal        @default(0) @db.Decimal(12, 4)
  status                ProjectStatus  @default(DRAFT)
  progressPercent       Int            @default(0)
  storySummary          String?
  artDirection          String?
  createdAt             DateTime       @default(now())
  updatedAt             DateTime       @updatedAt

  episodes       Episode[]
  scripts        Script[]
  characters     Character[]
  environments   Environment[]
  generationJobs GenerationJob[]
  assets         Asset[]
  renderJobs     RenderJob[]
  usageRecords   UsageRecord[]
  costRecords    CostRecord[]
  subtitles      Subtitle[]

  @@index([userId, updatedAt])
}

model Episode {
  id              String   @id @default(cuid())
  projectId       String
  project         Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  number          Int
  title           String
  summary         String?
  targetDurationSeconds Int?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  chapters        Chapter[]

  @@unique([projectId, number])
}

model Script {
  id          String   @id @default(cuid())
  projectId   String
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  sourceType  String
  language    String
  rawText     String
  structured  Json?
  assetId     String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([projectId])
}

model Chapter {
  id              String   @id @default(cuid())
  episodeId       String
  episode         Episode  @relation(fields: [episodeId], references: [id], onDelete: Cascade)
  number          Int
  title           String
  summary         String?
  targetDurationSeconds Int?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  scenes          Scene[]

  @@unique([episodeId, number])
}

model Scene {
  id              String   @id @default(cuid())
  chapterId       String
  chapter         Chapter  @relation(fields: [chapterId], references: [id], onDelete: Cascade)
  number          Int
  title           String
  summary         String?
  locationName    String?
  environmentId   String?
  environment     Environment? @relation(fields: [environmentId], references: [id])
  targetDurationSeconds Int?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  shots           Shot[]

  @@unique([chapterId, number])
  @@index([environmentId])
}

model Shot {
  id                 String         @id @default(cuid())
  sceneId            String
  scene              Scene          @relation(fields: [sceneId], references: [id], onDelete: Cascade)
  number             Int
  description        String
  compactPrompt      String?
  cameraAngle        String?
  cameraMovement     String?
  dialogue           String?
  narration          String?
  targetDurationSec  Int
  strategy           VideoStrategy  @default(TEXT_TO_VIDEO)
  status             SegmentStatus  @default(PENDING)
  characterIds       String[]
  previousShotId     String?
  continuityNotes    String?
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt
  videoSegments      VideoSegment[]
  audioSegments      AudioSegment[]

  @@unique([sceneId, number])
}

model Character {
  id                 String   @id @default(cuid())
  projectId          String
  project            Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name               String
  description        String?
  physicalAppearance String?
  clothing           String?
  colors             String?
  personality        String?
  voiceProfile       Json?
  relationships      Json?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  references         CharacterReference[]

  @@index([projectId])
}

model CharacterReference {
  id          String   @id @default(cuid())
  characterId String
  character   Character @relation(fields: [characterId], references: [id], onDelete: Cascade)
  assetId     String
  asset       Asset    @relation(fields: [assetId], references: [id])
  expression  String?
  isPrimary   Boolean  @default(false)
  createdAt   DateTime @default(now())

  @@index([characterId])
}

model Environment {
  id            String   @id @default(cuid())
  projectId     String
  project       Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name          String
  description   String?
  lighting      String?
  colorPalette  String?
  artDirection  String?
  cameraNotes   String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  references    EnvironmentReference[]
  scenes        Scene[]

  @@index([projectId])
}

model EnvironmentReference {
  id            String      @id @default(cuid())
  environmentId String
  environment   Environment @relation(fields: [environmentId], references: [id], onDelete: Cascade)
  assetId       String
  asset         Asset       @relation(fields: [assetId], references: [id])
  isPrimary     Boolean     @default(false)
  createdAt     DateTime    @default(now())

  @@index([environmentId])
}

model GenerationJob {
  id            String    @id @default(cuid())
  projectId     String
  project       Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  type          JobType
  status        JobStatus @default(PENDING)
  jobKey        String    @unique
  payload       Json?
  result        Json?
  errorMessage  String?
  attempts      Int       @default(0)
  maxAttempts   Int       @default(3)
  bullJobId     String?
  startedAt     DateTime?
  finishedAt    DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([projectId, status])
  @@index([type, status])
}

model Asset {
  id           String    @id @default(cuid())
  projectId    String?
  project      Project?  @relation(fields: [projectId], references: [id], onDelete: SetNull)
  type         AssetType
  storageKey   String
  bucket       String
  mimeType     String
  sizeBytes    Int?
  checksum     String?
  width        Int?
  height       Int?
  durationMs   Int?
  metadata     Json?
  createdAt    DateTime  @default(now())

  characterReferences    CharacterReference[]
  environmentReferences  EnvironmentReference[]
  videoSegments          VideoSegment[]         @relation("VideoAsset")
  audioSegments          AudioSegment[]         @relation("AudioAsset")
  subtitles              Subtitle[]
  renderOutputs          RenderJob[]            @relation("RenderOutput")

  @@index([projectId])
  @@index([storageKey])
}

model VideoSegment {
  id              String        @id @default(cuid())
  shotId          String
  shot            Shot          @relation(fields: [shotId], references: [id], onDelete: Cascade)
  assetId         String?
  asset           Asset?        @relation("VideoAsset", fields: [assetId], references: [id])
  status          SegmentStatus @default(PENDING)
  strategy        VideoStrategy
  provider        String
  modelId         String?
  promptVersion   String?
  durationMs      Int?
  nativeAudio     Boolean       @default(true)
  providerJobId   String?
  errorMessage    String?
  metadata        Json?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([shotId, status])
}

model AudioSegment {
  id           String        @id @default(cuid())
  shotId       String
  shot         Shot          @relation(fields: [shotId], references: [id], onDelete: Cascade)
  assetId      String?
  asset        Asset?        @relation("AudioAsset", fields: [assetId], references: [id])
  status       SegmentStatus @default(PENDING)
  source       AudioSource   @default(NATIVE_VIDEO)
  voiceId      String?
  language     String?
  text         String?
  durationMs   Int?
  errorMessage String?
  metadata     Json?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@index([shotId, status])
}

model Subtitle {
  id        String   @id @default(cuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  language  String
  format    String   @default("srt")
  assetId   String?
  asset     Asset?   @relation(fields: [assetId], references: [id])
  content   String?
  createdAt DateTime @default(now())

  @@index([projectId])
}

model RenderJob {
  id           String    @id @default(cuid())
  projectId    String
  project      Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  status       JobStatus @default(PENDING)
  outputAssetId String?
  outputAsset  Asset?    @relation("RenderOutput", fields: [outputAssetId], references: [id])
  resolution   Resolution
  errorMessage String?
  startedAt    DateTime?
  finishedAt   DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([projectId, status])
}

model ProviderConfig {
  id        String   @id @default(cuid())
  name      String   @unique
  kind      String
  enabled   Boolean  @default(true)
  config    Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model UsageRecord {
  id            String   @id @default(cuid())
  projectId     String?
  project       Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  provider      String
  model         String
  operation     String
  inputTokens   Int      @default(0)
  outputTokens  Int      @default(0)
  videoSeconds  Float    @default(0)
  imageCount    Int      @default(0)
  audioChars    Int      @default(0)
  metadata      Json?
  createdAt     DateTime @default(now())

  @@index([projectId, createdAt])
}

model CostRecord {
  id               String   @id @default(cuid())
  projectId        String?
  project          Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  usageRecordId    String?
  pricingVersion   String
  estimatedUsd     Decimal  @db.Decimal(12, 6)
  actualUsd        Decimal? @db.Decimal(12, 6)
  currency         String   @default("USD")
  createdAt        DateTime @default(now())

  @@index([projectId, createdAt])
}

model PricingCatalog {
  id        String   @id @default(cuid())
  version   String   @unique
  catalog   Json
  active    Boolean  @default(false)
  createdAt DateTime @default(now())
}
